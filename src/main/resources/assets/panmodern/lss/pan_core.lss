.pan-core-root {
  background: built-in(ui-mc:BORDER);
  margin-all: 5;
  padding-all: 5;
}

.pan-core-item-list {
  scroller-view-mode: vertical;
  scroller-vertical-display: always;
}

.pan-core-item-list .__scroller_view_view-container__ {
  width: 162;
  height: 180;
  flex-direction: row;
  flex-wrap: wrap;
}

.pan-core-player-inventory item-slot {
  show-item-tooltips: true;
}
